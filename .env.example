# Django: use development locally, preview for a hosted client-review site,
# and production only when the launch infrastructure is ready.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# Hardened staff administration.
# Generate different, non-obvious paths for every production client.
ADMIN_URL=admin/
ADMIN_LOCAL_LOGIN_URL=emergency-admin-login/
ENABLE_GOOGLE_ADMIN_SSO=false
ADMIN_GOOGLE_ALLOWED_EMAILS=

# Create a NEW Google OAuth web application for every client.
# Authorized redirect URI:
# https://CLIENT-DOMAIN/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Separate Google Services OAuth connection (never reuse admin SSO settings in code).
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=
GOOGLE_INTEGRATION_ENCRYPTION_KEY=
ENABLE_GOOGLE_SERVICES_INTEGRATION=false
GOOGLE_INTEGRATION_ALLOWED_EMAILS=

# Database: omit locally or in a single-instance Replit preview to use SQLite.
# Production must provide a PostgreSQL URL.
DATABASE_URL=
REQUIRE_POSTGRES=false
SQLITE_PATH=

# Email: create a NEW provider connection for every client.
# Postmark uses the server token as both SMTP username and password.
# Setting POSTMARK_SERVER_TOKEN automatically enables Django's SMTP backend.
POSTMARK_SERVER_TOKEN=
DEFAULT_FROM_EMAIL=Vossome Website <info@vossomewindowcleaning.com>
LEAD_NOTIFICATION_EMAIL=vossomewindowcleaning@gmail.com
ANTHEM_FORM_WEBHOOK_URL=
ENABLE_ANTHEM_FORM_DELIVERY=false
TRUST_PROXY_CLIENT_IP_HEADER=true
SERVER_EMAIL=info@vossomewindowcleaning.com
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_USE_TLS=true

# Google and other public site identifiers.
# Leave blank in the template and issue new values for each client.
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_TAG_MANAGER_CONTAINER_ID=
GOOGLE_SITE_VERIFICATION=
GOOGLE_MAPS_API_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional DigitalOcean Spaces media storage.
# Create a NEW bucket and access key for every client.
USE_SPACES=false
SERVE_LOCAL_MEDIA=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=nyc3
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_S3_CUSTOM_DOMAIN=

# Optional first-admin provisioning.
# Use a unique account and password for every client.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
